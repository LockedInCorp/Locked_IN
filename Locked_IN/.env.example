# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=locked_in

# MinIO (must be at least 8 characters each)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=
JWT_ISSUER=Locked_IN_Backend
JWT_AUDIENCE=Locked_IN_Frontend
